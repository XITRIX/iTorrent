    "preferences.network.interfaces.footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parallele Verbindungen können die Download-Geschwindigkeit erhöhen, werden aber Deine IP-Adresse enthüllen, wenn Du ein VPN benutzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parallel connection could increase download speed, but will leak your IP address in case of using VPN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión paralela podría aumentar la velocidad de descarga, pero filtrará tu dirección IP en caso de utilizar VPN"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione parallela potrebbe aumentare la velocità di download, ma farà trapelare il tuo indirizzo IP in caso di utilizzo di VPN."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połączenia równoległe mogą poprawić prędkość pobierania, ale ujawnią twój adres IP w przypadku używania VPNu"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Параллельное соединение может повысить скорость загрузки, но приведёт к утечке IP адреса при использовании VPN."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒரே நேரத்தில் பல இணைப்புகளைப் பயன்படுத்துவது பதிவிறக்க வேகத்தை அதிகரிக்கலாம். VPN பயன்படுத்தினால் உங்கள் IP முகவரி வெளிப்படும்."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağları aynı anda kullanmak indirme hızını artırabilir, ancak VPN kullanırken gerçek IP adresiniz açığa çıkabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "并行连接可以提高下载速度，但在使用VPN时会暴露您的IP地址"
          }
        }
      }
    },
