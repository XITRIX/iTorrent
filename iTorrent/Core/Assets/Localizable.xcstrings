    "add.dismiss.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Änderungen werfen verworfen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All changes will be lost"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se perderán todos los cambios"
          }
        },
