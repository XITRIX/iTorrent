    "preferences.storage.remove.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Du den Speicher entfernst, werden alle Torrents die damit im Zusammenhang in der iTorrent App nicht länger verfügbar sein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you will remove storage, all torrents related to it will be unreachable from iTorrent app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si elimina el almacenamiento, todos los torrents relacionados con él serán inaccesibles desde la aplicación iTorrent"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se rimuovi lo spazio di archiviazione, tutti i torrent ad esso correlati saranno irraggiungibili dall'app iTorrent"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli usuniesz to źródło pamięci, to wszystkie tam zapisane torrenty będą niedostępnie w aplikacji iTorrent"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы удалите хранилище, все торренты принадлежащие ему будут не доступны из приложения iTorrent  "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果移除这个存储，则将无法通过iTorrent访问与之相关的所有Torrent"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சேமிப்பிடத்தை அகற்றினால், அதனுடன் தொடர்புடைய டோரண்ட்களை iTorrent செயலியில் அணுக முடியாது"
          }
        }
      }
    },
