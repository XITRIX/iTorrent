    "list.empty.nodata.subtitle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um neue Torrents hinzuzufügen, drücke das ‚+‘-Icon in der unteren rechten Ecke, oder indem Du eine Torrent-Datei direkt aus der Dateien-App oder dem Browser öffnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To add new torrents you can press '+' icon in the bottom-left corner or by opening torrent file directly from Files app or Web Browser"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para añadir nuevos torrents puedes pulsar '+' en la esquina inferior izquierda o abriendo el archivo torrent directamente desde la aplicación Archivos o el navegador web."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aggiungere un nuovi torrent, puoi premere l’cona ‘+’ nell’angolo in basso a sinistra oppure aprendo  il file torrent direttamente dall’app File o dal Browser web"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby dodać nowy torrent, naciśnij przycisk ‘+’ w dolnym lewym rogu lub otwierając plik torrentu bezpośrednio z aplikacji Pliki czy Przeglądarki"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для добавления загрузки нажмите '+' в углу экрана или откройте torrent файл из приложения Файлы или Веб Браузера"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要添加新的Torrent，您可以点击左下角的“+”图标，也可以直接从“文件”APP或浏览器打开Torrent文件"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிய டோரண்ட்களைச் சேர்க்க, கீழ் இடது மூலையில் உள்ள '+' குறியீட்டை அழுத்தவும் அல்லது Files செயலி / இணைய உலாவியில் டோரண்ட் கோப்பை நேரடியாகத் திறக்கவும்"
          }
        }
      }
    },
