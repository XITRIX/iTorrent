            "value": "Sei sicuro di voler scollegare il tuo account Patreon?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz odłączyć konto Patreon?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите отвязать ваш Patreon аккаунт?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您确定要取消关联Patreon账号吗？"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Patreon கணக்கின் இணைப்பை நீக்க விரும்புகிறீர்களா?"
          }
        }
      }
    },
    "patreon.creator.description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwickler von iTorrent"
          }
        },
        "en": {
