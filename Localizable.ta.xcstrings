    },
    "preferences.storage.warning.message": {
      "comment": "`",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls Du externe Festplatten benutzt, darfst Du diese erst entfernen, nachdem Du iTorrent geschlossen hast. Andernfalls kann iTorrent nicht mit Sicherheit garantieren, dass alle heruntergeladenen Dateien sicher gespeichert wurden. Dies könnte zu korrupten Zuständen der Torrents auf dem entfernten Gerät führen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In case of using external drives, you should eject it only after closing iTorrent app. Otherwise iTorrent cannot garantee safety storing of your downloaded files and could potentially corrups current states of torrents from ejected drive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En caso de utilizar unidades externas, debe expulsarlas sólo después de cerrar la aplicación iTorrent. De lo contrario, iTorrent no puede garantizar el almacenamiento seguro de los archivos descargados y podría corromper los estados actuales de los torrents de la unidad expulsada"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In caso di utilizzo di unità esterne, dovresti espellerle solo dopo aver chiuso l'app iTorrent. Altrimenti iTorrent non può garantire la conservazione sicura dei file scaricati e potrebbe potenzialmente corrompere gli stati correnti dei torrent dall'unità espulsa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W przypadku używania zewnętrznych dysków, powinno się wysunąć dysk po zamknięciu aplikacji iTorrent. Inaczej iTorrent nie może gwarantować bezpieczeństwa Twoich plików przed uszkodzeniem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В случае использования внешних дисков извлекать их следует только после закрытия приложения iTorrent. В противном случае iTorrent не может гарантировать безопасное хранение загруженных вами файлов и потенциально может испортить текущее состояние торрентов с извлеченного диска."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果使用外部储存，请在关闭iTorrent后再将其弹出。否则，iTorrent将无法保证您下载的文件的安全，并且可能会破坏被弹出的储存中Torrent的状态。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வெளிப்புற Drive-களைப் பயன்படுத்தினால், iTorrent செயலியை மூடிய பிறகே அவற்றை Eject செய்ய வேண்டும். இல்லையெனில், பதிவிறக்கிய கோப்புகளின் பாதுகாப்பை iTorrent உறுதிப்படுத்த முடியாது; மேலும் அந்த Drive-இல் உள்ள டோரண்ட்களின் தற்போதைய நிலையும் பாதிக்கப்படலாம்."
          }
        }
      }
    },
