    "list.add.url.error.authentication": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Tracker erfordert möglicherweise eine Anmeldung. Öffne den Link im Browser, lade die .torrent-Datei herunter und teile sie anschließend mit iTorrent."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tracker requires a signed-in browser session. Open the link in the browser, download the .torrent file, then share it with iTorrent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tracker requiere una sesión iniciada en el navegador. Abre el enlace en el navegador, descarga el archivo .torrent y compártelo con iTorrent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo tracker richiede l'accesso nel browser. Apri il link nel browser, scarica il file .torrent e condividilo con iTorrent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten tracker wymaga zalogowanej sesji przeglądarki. Otwórz link w przeglądarce, pobierz plik .torrent, a następnie udostępnij go aplikacji iTorrent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот трекер требует входа через браузер. Откройте ссылку в браузере, скачайте файл .torrent, затем поделитесь им с iTorrent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Tracker 需要已登录的浏览器会话。请在浏览器中打开链接，下载 .torrent 文件，然后共享到 iTorrent。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த Tracker-க்கு உள்நுழைந்துள்ள உலாவி அமர்வு தேவை. இணைப்பை உலாவியில் திறந்து, .torrent கோப்பைப் பதிவிறக்கி, பின்னர் iTorrent-உடன் பகிரவும்."
          }
        }
      }
    },
    "list.add.url.error.http": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Torrent-Anfrage ist mit HTTP-Status %ld fehlgeschlagen. Versuche, den Link im Browser zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The torrent request failed with HTTP status %ld. Try opening the link in the browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud del torrent falló con el estado HTTP %ld. Prueba a abrir el enlace en el navegador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La richiesta del torrent non è riuscita con stato HTTP %ld. Prova ad aprire il link nel browser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żądanie torrenta nie powiodło się ze stanem HTTP %ld. Spróbuj otworzyć link w przeglądarce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос torrent-файла завершился с HTTP-статусом %ld. Попробуйте открыть ссылку в браузере."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent 请求失败，HTTP 状态码为 %ld。请尝试在浏览器中打开链接。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "டோரண்ட் கோரிக்கை HTTP நிலை %ld காரணமாகத் தோல்வியடைந்தது. இணைப்பை உலாவியில் திறந்து முயற்சிக்கவும்."
          }
        }
      }
    },
    "list.add.url.error.invalidTorrent": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat keine gültige .torrent-Datei zurückgegeben. Möglicherweise ist eine Anmeldung im Browser erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server did not return a valid .torrent file. You may need to sign in using the browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no devolvió un archivo .torrent válido. Puede que tengas que iniciar sesión desde el navegador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server non ha restituito un file .torrent valido. Potrebbe essere necessario accedere dal browser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer nie zwrócił prawidłowego pliku .torrent. Może być wymagane zalogowanie się w przeglądarce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не вернул корректный файл .torrent. Возможно, требуется войти через браузер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器未返回有效的 .torrent 文件。你可能需要先在浏览器中登录。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரியான .torrent கோப்பை சர்வர் வழங்கவில்லை. உலாவியில் உள்நுழைய வேண்டியிருக்கலாம்."
          }
        }
      }
    },
