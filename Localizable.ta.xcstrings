    "add.dismiss.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Änderungen werfen verworfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All changes will be lost"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perderán todos los cambios"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i cambiamenti saranno persi"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie zmiany zostaną odrzucone"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все не сохранённые изменения будут утеряны"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有未保存的更改将会丢失"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைத்து மாற்றங்களும் இழக்கப்படும்"
          }
        }
      }
    },
    "add.dismiss.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirklich verwerfen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure to dismiss?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Está seguro de que desea descartar?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di voler annullare?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz odrzucić?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены что хотите закрыть это окно?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你确定要丢弃吗？"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிச்சயமாக வெளியேற வேண்டுமா?"
          }
        }
      }
    },
