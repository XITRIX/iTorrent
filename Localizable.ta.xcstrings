    "preferences.trackers.autoadding.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch alle Tracker zu neu hinzugefügten öffentlichen Torrents hinzufügen. Private Torrents sind ausgeschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically add all trackers to newly added public torrents. Private torrents are excluded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade automáticamente todos los trackers a los nuevos torrents públicos. Los torrents privados están excluidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi automaticamente tutti i tracker ai nuovi torrent pubblici. I torrent privati sono esclusi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie dodawaj wszystkie trackery do nowych publicznych torrentów. Prywatne torrenty są wykluczone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически добавлять все трекеры в новые публичные торренты. Приватные торренты исключены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动将所有 Tracker 添加到新建的公开 Torrent。私有 Torrent 不会添加。"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிதாகச் சேர்க்கப்படும் பொது டோரண்ட்களில் அனைத்து Trackers-ஐயும் தானாகச் சேர். தனிப்பட்ட டோரண்ட்கள் இதில் சேர்க்கப்படாது."
          }
        }
      }
    },
